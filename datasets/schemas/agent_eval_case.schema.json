{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "AgentEvalCaseProtocol",
  "description": "Unified standard schema for AI Agent evaluation benchmark testcases (L0 to L4 compatible)",
  "type": "object",
  "properties": {
    "task_id": {
      "type": "string",
      "description": "Unique identifier for the test case"
    },
    "layer": {
      "type": "string",
      "enum": [
        "L0",
        "L1",
        "L2",
        "L3",
        "L4"
      ],
      "description": "Evaluation target layer"
    },
    "domain": {
      "type": "string",
      "description": "Domain tag (e.g. tool, rag, coding, service)"
    },
    "instruction": {
      "type": "string",
      "description": "User prompt or system task instruction"
    },
    "environment": {
      "type": "object",
      "properties": {
        "sandbox_image": {
          "type": "string"
        },
        "initial_state": {
          "type": "object"
        }
      }
    },
    "ground_truth": {
      "type": "object",
      "properties": {
        "expected_tools": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "name": {
                "type": "string"
              },
              "arguments": {
                "type": "object"
              }
            },
            "required": [
              "name"
            ]
          }
        },
        "expected_state_diff": {
          "type": "object"
        },
        "golden_keywords": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "required_fields": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "min_steps": {
          "type": "integer"
        },
        "max_steps": {
          "type": "integer"
        }
      },
      "required": []
    },
    "context_chunks": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "metadata": {
      "type": "object"
    }
  },
  "required": [
    "task_id",
    "layer",
    "instruction",
    "ground_truth"
  ]
}